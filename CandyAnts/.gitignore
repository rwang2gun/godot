# Godot 4 표준
.godot/
.import/
*.translation
export.cfg
export_presets.cfg

# 빌드/임포트 산출물
*.tmp
*.import

# IDE/OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Phase 1 ephemeral — TDD bypass 토큰은 절대 staging 금지
scripts/hooks/.tdd_bypass

# 로컬 secrets — DISCORD_WEBHOOK_URL 등. scripts/notify.py가 자동 로드.
.env
.env.local

# 외부 도구 (codex map-editor 트랙)
tools/map_editor/node_modules/
# 상위 .gitignore의 *.html 패턴 예외 — map-editor public asset
!tools/map_editor/public/*.html

# Claude Code worktrees — 다른 프로젝트/세션의 임시 작업 트리. phase complete 흐름에서
# scripts/execute.py가 untracked path 분류 시 거부하지 않도록 명시적 ignore.
# (phase 14 plan adversarial-review Round 2 MEDIUM 대응)
**/.claude/worktrees/**
